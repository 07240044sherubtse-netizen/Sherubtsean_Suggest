<%- include('partials/header') %>

<main class="auth-container">
  <section class="auth-card">
    <h1>Verify reset code</h1>

    <p>
      Enter the six-digit password-reset code sent to your email.
      The code expires after 10 minutes.
    </p>

    <% if (typeof messages !== 'undefined' && messages.error) { %>
      <% const errors = Array.isArray(messages.error)
        ? messages.error
        : [messages.error]; %>

      <% errors.forEach(function(message) { %>
        <p class="flash-error"><%= message %></p>
      <% }); %>
    <% } %>

    <% if (typeof messages !== 'undefined' && messages.success) { %>
      <% const successes = Array.isArray(messages.success)
        ? messages.success
        : [messages.success]; %>

      <% successes.forEach(function(message) { %>
        <p class="flash-success"><%= message %></p>
      <% }); %>
    <% } %>

    <form action="/auth/verify-reset-code" method="POST">
      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <label for="email">Email address</label>
      <input
        id="email"
        type="email"
        name="email"
        value="<%= typeof email !== 'undefined' ? email : '' %>"
        autocomplete="email"
        required
      >

      <label for="code">Six-digit reset code</label>
      <input
        id="code"
        type="text"
        name="code"
        inputmode="numeric"
        pattern="[0-9]{6}"
        minlength="6"
        maxlength="6"
        placeholder="Enter your 6-digit code"
        autocomplete="one-time-code"
        required
      >

      <button type="submit">Verify reset code</button>
    </form>

    <p>
      <a href="/auth/forgot-password">Request a new code</a>
    </p>

    <p>
      <a href="/auth">Back to login</a>
    </p>
  </section>
</main>

<%- include('partials/footer') %>
