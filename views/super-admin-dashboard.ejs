<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="staff-banner staff-banner-super">
      <p class="eyebrow">Platform owner</p>
      <h1>Super Admin</h1>
      <p class="section-lead">Create administrators, manage roles, categories, and the full campus suggestion platform. Super Admin accounts can only be created with the setup command.</p>
    </div>

    <nav class="tabs">
      <a class="<%= tab === 'overview' ? 'active' : '' %>" href="/super-admin?tab=overview">Overview</a>
      <a class="<%= tab === 'suggestions' ? 'active' : '' %>" href="/super-admin?tab=suggestions">Suggestions</a>
      <a class="<%= tab === 'users' ? 'active' : '' %>" href="/super-admin?tab=users">Users &amp; admins</a>
      <a class="<%= tab === 'categories' ? 'active' : '' %>" href="/super-admin?tab=categories">Categories</a>
    </nav>

    <% if (tab === 'overview') { %>
      <div class="stats-grid light-stats">
        <div><strong><%= stats.users %></strong><span>Users</span></div>
        <div><strong><%= stats.admins %></strong><span>Admins</span></div>
        <div><strong><%= stats.superAdmins %></strong><span>Super admins</span></div>
        <div><strong><%= stats.inactive %></strong><span>Disabled accounts</span></div>
        <div><strong><%= stats.suggestions %></strong><span>Suggestions</span></div>
        <div><strong><%= stats.comments %></strong><span>Comments</span></div>
        <div><strong><%= stats.resolved %></strong><span>Resolved</span></div>
      </div>

      <h2>Recent activity</h2>
      <% if (!recent.length) { %>
        <p>No suggestions yet.</p>
      <% } else { %>
        <div class="card-grid">
          <% recent.forEach((suggestion) => { %>
            <%- include('partials/suggestion-card', { suggestion }) %>
          <% }) %>
        </div>
      <% } %>
    <% } %>

    <% if (tab === 'suggestions') { %>
      <div class="card" style="margin-bottom: 1.5rem;">
        <h2>Download feedback</h2>
        <p>Export campus suggestions and feedback into a file for reporting, analysis, and record keeping.</p>

        <div class="button-group" style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
          <a class="btn btn-primary" href="/super-admin/feedback/export/xlsx">Download Excel (.xlsx)</a>
          <a class="btn btn-ghost" href="/super-admin/feedback/export/csv">Download CSV (.csv)</a>
          <a class="btn btn-ghost" href="/super-admin/feedback/export/pdf">Download PDF (.pdf)</a>
          <a class="btn btn-ghost" href="/super-admin/feedback/export/json">Download JSON (.json)</a>
        </div>

        <p class="help">Exports may contain student feedback. Store downloaded files securely and share them only with authorized people.</p>
      </div>

      <form class="filter-bar" method="get" action="/super-admin">
        <input type="hidden" name="tab" value="suggestions">

        <label>
          Search
          <input type="search" name="q" value="<%= filters.q %>" maxlength="120">
        </label>

        <label>
          Category
          <select name="category">
            <option value="">All</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category.id %>" <%= filters.category === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
            <% }) %>
          </select>
        </label>

        <label>
          Status
          <select name="status">
            <option value="">All</option>
            <option value="Open" <%= filters.status === 'Open' ? 'selected' : '' %>>Open</option>
            <option value="In Progress" <%= filters.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
            <option value="Resolved" <%= filters.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
          </select>
        </label>

        <button class="btn btn-primary" type="submit">Filter</button>
      </form>

      <% if (!suggestions.length) { %>
        <div class="empty-state">
          <p>No suggestions found.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>

            <tbody>
              <% suggestions.forEach((item) => { %>
                <tr>
                  <td>
                    <a href="/suggestions/<%= item.id %>"><%= item.title %></a>
                  </td>

                  <td><%= item.author_name %></td>

                  <td>
                    <form action="/admin/suggestions/<%= item.id %>/status" method="post" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="from" value="super-admin">

                      <select name="status" onchange="this.form.submit()">
                        <option value="Open" <%= item.status === 'Open' ? 'selected' : '' %>>Open</option>
                        <option value="In Progress" <%= item.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                        <option value="Resolved" <%= item.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                      </select>
                    </form>
                  </td>

                  <td>
                    <form action="/suggestions/<%= item.id %>/delete" method="post" data-confirm="Remove this suggestion?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="from" value="super-admin">
                      <button class="btn btn-danger" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (suggestionPages > 1) { %>
          <nav class="pagination">
            <% if (filters.page > 1) { %>
              <a href="/super-admin?tab=suggestions&q=<%= encodeURIComponent(filters.q) %>&category=<%= filters.category %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= filters.page - 1 %>">Previous</a>
            <% } %>

            <span>Page <%= filters.page %> of <%= suggestionPages %></span>

            <% if (filters.page < suggestionPages) { %>
              <a href="/super-admin?tab=suggestions&q=<%= encodeURIComponent(filters.q) %>&category=<%= filters.category %>&status=<%= encodeURIComponent(filters.status) %>&page=<%= filters.page + 1 %>">Next</a>
            <% } %>
          </nav>
        <% } %>
      <% } %>
    <% } %>

    <% if (tab === 'users') { %>
      <form action="/super-admin/users" method="post" class="form compact-form staff-panel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <h2>Create an administrator</h2>
        <p class="help">This creates a campus Admin, not another Super Admin.</p>

        <label>
          Full name
          <input type="text" name="name" required minlength="2" maxlength="120">
        </label>

        <label>
          Email
          <input type="email" name="email" required maxlength="255">
        </label>

        <label>
          Password
          <input type="password" name="password" required minlength="8" maxlength="72">
        </label>

        <label>
          Confirm password
          <input type="password" name="confirmPassword" required minlength="8" maxlength="72">
        </label>

        <button class="btn btn-accent" type="submit">Create admin</button>
      </form>

      <form class="filter-bar" method="get" action="/super-admin">
        <input type="hidden" name="tab" value="users">

        <label>
          Search users
          <input type="search" name="q" value="<%= filters.q %>" maxlength="120">
        </label>

        <button class="btn btn-primary" type="submit">Search</button>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>

                <td>
                  <% if (user.role === 'super_admin' || Number(user.id) === Number(currentUser.id)) { %>
                    <span class="role-badge role-<%= user.role %>"><%= user.role.replace('_', ' ') %></span>
                  <% } else { %>
                    <form action="/super-admin/users/<%= user.id %>/role" method="post" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <select name="role" onchange="this.form.submit()">
                        <option value="student" <%= user.role === 'student' ? 'selected' : '' %>>Student</option>
                        <option value="tutor" <%= user.role === 'tutor' ? 'selected' : '' %>>Tutor</option>
                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      </select>
                    </form>
                  <% } %>
                </td>

                <td><%= user.is_active ? 'Active' : 'Disabled' %></td>

                <td>
                  <% if (Number(user.id) === Number(currentUser.id)) { %>
                    <span class="muted">You</span>
                  <% } else { %>
                    <form action="/super-admin/users/<%= user.id %>/toggle-active" method="post" data-confirm="<%= user.is_active ? 'Disable this account?' : 'Reactivate this account?' %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <button class="btn btn-ghost" type="submit">
                        <%= user.is_active ? 'Disable' : 'Reactivate' %>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (userPages > 1) { %>
        <nav class="pagination">
          <% if (filters.page > 1) { %>
            <a href="/super-admin?tab=users&q=<%= encodeURIComponent(filters.q) %>&page=<%= filters.page - 1 %>">Previous</a>
          <% } %>

          <span>Page <%= filters.page %> of <%= userPages %></span>

          <% if (filters.page < userPages) { %>
            <a href="/super-admin?tab=users&q=<%= encodeURIComponent(filters.q) %>&page=<%= filters.page + 1 %>">Next</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>

    <% if (tab === 'categories') { %>
      <form action="/super-admin/categories" method="post" class="form compact-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <h2>Add category</h2>

        <label>
          Name
          <input type="text" name="name" required minlength="2" maxlength="80">
        </label>

        <label>
          Description
          <input type="text" name="description" maxlength="400">
        </label>

        <button class="btn btn-primary" type="submit">Add</button>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Suggestions</th>
              <th></th>
            </tr>
          </thead>

          <tbody>
            <% categories.forEach((category) => { %>
              <tr>
                <td>
                  <form action="/super-admin/categories/<%= category.id %>/edit" method="post" class="form compact-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="text" name="name" value="<%= category.name %>" required maxlength="80">
                    <input type="text" name="description" value="<%= category.description || '' %>" maxlength="400">
                    <button class="btn btn-secondary" type="submit">Save</button>
                  </form>
                </td>

                <td><%= categoryCounts[category.id] %></td>

                <td>
                  <% if (categoryCounts[category.id] === 0) { %>
                    <form action="/super-admin/categories/<%= category.id %>/delete" method="post" data-confirm="Delete this category?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-danger" type="submit">Delete</button>
                    </form>
                  <% } else { %>
                    <span class="muted">In use</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>