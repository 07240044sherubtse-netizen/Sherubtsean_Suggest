 <%- include('partials/header') %>

<main class="auth-container">
  <section class="auth-card">
    <h1>Forgot your password?</h1>

    <p>
      Enter the email address associated with your account.
      If your account is eligible, we'll send you a six-digit password-reset code.
    </p>

    <% if (typeof messages !== 'undefined' && messages.error) { %>
      <% const errors = Array.isArray(messages.error)
        ? messages.error
        : [messages.error]; %>

      <% errors.forEach(function(message) { %>
        <p class="flash-error"><%= message %></p>
      <% }); %>
    <% } %>

    <% if (typeof messages !== 'undefined' && messages.success) { %>
      <% const successes = Array.isArray(messages.success)
        ? messages.success
        : [messages.success]; %>

      <% successes.forEach(function(message) { %>
        <p class="flash-success"><%= message %></p>
      <% }); %>
    <% } %>

    <form action="/auth/forgot-password" method="POST">
      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <label for="email">Email address</label>
      <input
        id="email"
        type="email"
        name="email"
        value="<%= typeof email !== 'undefined' ? email : '' %>"
        autocomplete="email"
        placeholder="Enter your registered email"
        required
      >

      <button type="submit">Send reset code</button>
    </form>

    <p>
      <a href="/auth">Back to login</a>
    </p>
  </section>
</main>

<%- include('partials/footer') %>