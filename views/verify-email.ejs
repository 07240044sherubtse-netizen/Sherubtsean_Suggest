
<%- include('partials/header') %>

<main class="auth-container">
  <section class="auth-card">
    <h1>Verify your email</h1>

    <p>
      We've sent a six-digit verification code to your email address.
      Enter the code below to activate your account.
    </p>

    <% if (typeof messages !== 'undefined' && messages.error) { %>
      <% const errors = Array.isArray(messages.error)
        ? messages.error
        : [messages.error]; %>

      <% errors.forEach(function(message) { %>
        <p class="flash-error"><%= message %></p>
      <% }); %>
    <% } %>

    <% if (typeof messages !== 'undefined' && messages.success) { %>
      <% const successes = Array.isArray(messages.success)
        ? messages.success
        : [messages.success]; %>

      <% successes.forEach(function(message) { %>
        <p class="flash-success"><%= message %></p>
      <% }); %>
    <% } %>

    <form action="/auth/verify" method="POST">
      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <label for="email">Email address</label>
      <input
        id="email"
        type="email"
        name="email"
        value="<%= email %>"
        autocomplete="email"
        required
      >

      <label for="code">Six-digit verification code</label>
      <input
        id="code"
        type="text"
        name="code"
        inputmode="numeric"
        pattern="[0-9]{6}"
        minlength="6"
        maxlength="6"
        placeholder="Enter your 6-digit code"
        autocomplete="one-time-code"
        required
      >

      <button type="submit">Verify email</button>
    </form>

    <form
      action="/auth/resend-verification"
      method="POST"
      class="resend-form"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <input
        type="hidden"
        name="email"
        value="<%= email %>"
      >

      <button type="submit">Resend verification code</button>
    </form>

    <p>
      <a href="/auth">Back to login</a>
    </p>
  </section>
</main>

<%- include('partials/footer') %>
