
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> · Sherubtsean Suggest</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container nav-wrap">

      <!-- Brand logo -->
      <a class="brand" href="/">
        <span class="brand-mark">
          <img
            src="/images/logo.jpeg"
            alt="Sherubtsean Suggest logo"
            class="brand-logo"
          >
        </span>

        <span class="brand-text">
          <strong>Sherubtsean Suggest</strong>
          <small>Sherubtse College</small>
        </span>
      </a>

      <!-- Mobile menu button -->
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <span class="sr-only">Menu</span>
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- Navigation links -->
      <nav id="site-nav" class="site-nav" data-nav>

        <a
          href="/"
          class="<%= currentPath === '/' ? 'active' : '' %>"
        >Home</a>

        <a
          href="/suggestions"
          class="<%= currentPath.startsWith('/suggestions') ? 'active' : '' %>"
        >Suggestions</a>

        <% if (currentUser) { %>

          <a
            href="/dashboard"
            class="<%= currentPath === '/dashboard' ? 'active' : '' %>"
          >Dashboard</a>

          <% if (isSuperAdminUser) { %>
            <a
              href="/super-admin"
              class="<%= currentPath.startsWith('/super-admin') ? 'active' : '' %>"
            >Super Admin</a>
          <% } %>

          <% if (isStaffUser) { %>
            <a
              href="/admin"
              class="<%= currentPath === '/admin' || currentPath.startsWith('/admin/') ? 'active' : '' %>"
            >Admin</a>
          <% } %>

          <!-- User profile -->
          <div class="nav-profile">
            <span class="nav-avatar" aria-hidden="true">
              <%= currentUser.name.trim().split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase() %>
            </span>

          </div>

          <!-- Logout -->
          <form
            action="/auth/logout"
            method="post"
            class="inline-form"
          >
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >

            <button type="submit" class="btn btn-ghost">
              Logout
            </button>
          </form>

        <% } else { %>

          <a
            href="/auth"
            class="<%= currentPath === '/auth' ? 'active' : '' %>"
          >Login</a>

          <a href="/auth?tab=register" class="btn btn-accent">
            Register
          </a>

        <% } %>

      </nav>
    </div>
  </header>

  <main id="main">
    <div class="container">
      <%- include('flash-messages') %>
    </div>
